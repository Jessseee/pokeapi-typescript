{
  "name": "pokeapi-typescript",
  "version": "3.0.3",
  "description": "Typescript SDK for PokeAPI (https://pokeapi.co)",
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "Pokemon",
    "PokeAPI",
    "Typescript",
    "API"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "pnpm eslint src/**/*.ts",
    "lint:fix": "pnpm eslint src/**/*.ts --fix",
    "preversion": "pnpm run lint",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "prepare": "pnpm run build"
  },
  "author": "Jessseee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jessseee/pokeapi-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/Jessseee/pokeapi-typescript/issues"
  },
  "homepage": "https://github.com/Jessseee/pokeapi-typescript#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "dependencies": {
    "@discordjs/collection": "^2.1.1"
  }
}
